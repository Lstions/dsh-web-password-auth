{
  "name": "dsh-web-password-auth",
  "version": "0.5.0",
  "private": false,
  "description": "Username and password sign-in for the DeepSeek Harness Web UI, with persistent sessions, an in-app security settings page, and optional TOTP two-factor authentication",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon.svg": "./icon.svg",
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lstions/dsh-web-password-auth.git"
  },
  "homepage": "https://github.com/Lstions/dsh-web-password-auth#readme",
  "bugs": {
    "url": "https://github.com/Lstions/dsh-web-password-auth/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "authentication",
    "totp",
    "two-factor",
    "password",
    "cordis"
  ]
}
